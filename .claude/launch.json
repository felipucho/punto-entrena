{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "punto-dev",
      "runtimeExecutable": "node",
      "runtimeArgs": ["node_modules/@tinacms/cli/bin/tinacms", "dev", "-c", "node node_modules/next/dist/bin/next dev -p 3200"],
      "port": 3200
    },
    {
      "name": "punto-start",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start"],
      "port": 3000
    },
    {
      "name": "punto-start-auto",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start"],
      "port": 3100,
      "autoPort": true
    }
  ]
}
